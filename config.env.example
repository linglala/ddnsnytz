# 复制此文件为 config.env 并填入真实值
# cp config.env.example config.env
# 注意：config.env 已加入 .gitignore，不会被提交

# Cloudflare 配置
API_TOKEN=""       # Cloudflare API Token
ZONE_ID=""         # Cloudflare Zone ID
RECORD_NAME=""     # 你的域名，例如 ddns.example.com

# Telegram 通知
TG_BOT_TOKEN=""    # Telegram Bot Token
TG_CHAT_ID=""      # Telegram Chat ID

# 可选配置（有默认值）
TTL="1"            # DNS TTL，1 = 自动
PROXIED="false"    # 是否开启 Cloudflare 代理（小黄云）
